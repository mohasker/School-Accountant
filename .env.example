# Local development
DATABASE_URL=postgresql://school:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/school_accounting
WEB_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
DEMO_MODE=true
# CLI only, never commit an actual password
DEMO_PASSWORD=

# Docker / production (deploy/docker-compose.prod.yml)
DB_PASSWORD=
DOMAIN=madar.example.com
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=
TENANT_NAME=
# Upload virus scanning command outside demo mode (ClamAV clamscan by default)
UPLOAD_SCANNER=clamscan

# Optional: assistant key (or set it from the policy screen as the system administrator)
ANTHROPIC_API_KEY=

# مفتاح تشفير الأسرار المحفوظة (ربط OneDrive ومفتاح المساعد). 16 حرفاً فأكثر؛ لا تغيّره بعد الحفظ
SECRETS_KEY=
