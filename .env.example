# Local development
DATABASE_URL=postgresql://school:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/school_accounting
WEB_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
DEMO_MODE=true
# CLI only, never commit an actual password
DEMO_PASSWORD=

# Docker / production (deploy/docker-compose.prod.yml)
DB_PASSWORD=
DOMAIN=madar.example.com
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=
TENANT_NAME=
# Upload virus scanning command outside demo mode (ClamAV clamscan by default)
UPLOAD_SCANNER=clamscan
