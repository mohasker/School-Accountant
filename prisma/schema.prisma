generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  schools     School[]
  users       User[]
  holidays    Holiday[]
  policies    PolicySetting[]
  catalog     BudgetCatalog[]
  archives    Archive[]
  notes       Note[]
  aiKey       String          @default("")
  odClientId  String          @default("")
  odSecret    String          @default("")
  odAuthority String          @default("common")
  odRefresh   String          @default("")
  odAccount   String          @default("")
  odFolder    String          @default("MOESAS-Archive")
  smtpHost    String          @default("")
  smtpPort    Int             @default(587)
  smtpUser    String          @default("")
  smtpPass    String          @default("")
  smtpFrom    String          @default("")
  digestOn    Boolean         @default(false)
  digestDay   Int             @default(0)
  digestHour  Int             @default(7)
  lastDigest  String          @default("")
  helpVideos  Json            @default("{}")
  /// Departments a completion certificate and its covering letter may be addressed to (the administrator extends the list).
  addressees  Json            @default("[\"إدارة الشؤون المالية\", \"إدارة الخدمات العامة\", \"إدارة المشتريات والمناقصات\"]")
  tgToken     String          @default("")
  tgOn        Boolean         @default(false)
  /// Issuing from the bot may be switched off, or limited to files up to this value (0 = no limit).
  tgIssue     Boolean         @default(true)
  tgLimit     Decimal         @default(0) @db.Decimal(18, 2)
  /// Paper-file check: whether pages may be read by the AI service, and the administration's requirements.
  checkAi     Boolean         @default(false)
  checkRules  Json            @default("[]")
  /// Documents always required at payment, and whether accountants may use their own Claude / ChatGPT for the reading.
  checkDocs   Json            @default("[\"QUOTE\", \"CR\", \"DELIVERY_NOTE\", \"RECEIPT\", \"INVOICE\", \"IBAN\", \"UNDERTAKING\"]")
  checkPrompt Boolean         @default(true)
  /// Optional gate before a completion certificate: the required documents ticked, IBAN verified, registration valid.
  certGate    Boolean         @default(false)
  /// Second-person approval: IBAN changes wait for another user; certificates from this case value need another user to approve (0 = none).
  fourEyes      Boolean       @default(false)
  fourEyesLimit Decimal       @default(0) @db.Decimal(18, 2)
  cards       SupplierCard[]
  legacy      LegacyCertificate[]
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  username      String       @unique
  name          String
  passwordHash  String
  active        Boolean      @default(true)
  memberships   Membership[]
  sessions      Session[]
  isTenantAdmin Boolean      @default(false)
  lastLoginAt   DateTime?
  logins        LoginLog[]
  email         String       @default("")
  /// Set for accounts created with a known initial password; cleared when the user chooses their own.
  mustChangePassword Boolean  @default(false)
  /// Telegram: the chat linked to this account and the one-time code used to link it.
  tgChatId      String       @default("")
  tgCode        String       @default("")
  tgCodeExp     DateTime?
  /// Day (YYYY-MM-DD) the daily Telegram digest was last sent.
  tgDigestDay   String       @default("")

  @@unique([id, tenantId])
}

model School {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  code               String
  name               String
  principal          String
  pettyCustodian     String       @default("")
  educationCustodian String       @default("")
  bookCustodian      String       @default("")
  active             Boolean      @default(true)
  memberships        Membership[]
  years              FiscalYear[]
  principals         PrincipalTerm[]
  suppliers          Supplier[]
  cases              Case[]
  orderPrefix        String       @default("")
  purchasingOfficer  String       @default("")
  erpCode            String       @default("")
  plans              BudgetPlan[]
  /// The account that added the school; its data is entered by that accountant and seen by the administrator.
  createdBy          String?      @db.Uuid
  lat                Float?
  lng                Float?
  createdAt          DateTime     @default(now())

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([createdBy])
}

model Membership {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  userId   String   @db.Uuid
  schoolId String   @db.Uuid
  roles    String[]
  user     User     @relation(fields: [userId, tenantId], references: [id, tenantId])
  school   School   @relation(fields: [schoolId, tenantId], references: [id, tenantId])

  @@unique([userId, schoolId])
}

model Session {
  tokenHash String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  csrf      String
  expiresAt DateTime
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
}

model FiscalYear {
  id        String          @id @default(uuid()) @db.Uuid
  schoolId  String          @db.Uuid
  school    School          @relation(fields: [schoolId], references: [id])
  label     String
  startDate DateTime        @db.Date
  endDate   DateTime        @db.Date
  closed    Boolean         @default(false)
  cases     Case[]
  budgets   Budget[]
  imprests  Imprest[]
  plans     BudgetPlan[]
  direct    DirectExpense[]

  @@unique([id, schoolId])
  @@unique([schoolId, label])
}

model Supplier {
  id       String  @id @default(uuid()) @db.Uuid
  schoolId String  @db.Uuid
  school   School  @relation(fields: [schoolId], references: [id])
  name     String
  cr       String?
  iban     String  @default("")
  phone    String  @default("")
  email    String  @default("")
  active   Boolean @default(true)
  version  Int     @default(1)
  quotes   Quote[]
  cases    Case[]
  cardId   String? @db.Uuid
  card     SupplierCard? @relation(fields: [cardId], references: [id])

  @@unique([schoolId, cr])
  @@unique([id, schoolId])
}

/// The supplier bank: one card per company across all schools, with the full contact and bank data.
model SupplierCard {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  legalName String     @default("")
  cr        String     @default("")
  iban      String     @default("")
  bank      String     @default("")
  phone     String     @default("")
  mobile    String     @default("")
  email     String     @default("")
  contact   String     @default("")
  address   String     @default("")
  category  String     @default("")
  note      String     @default("")
  nameEn    String     @default("")
  crExpiry  DateTime?  @db.Date
  accountsEmail String @default("")
  website   String     @default("")
  beneficiary String   @default("")
  ibanVerified Boolean @default(false)
  /// An IBAN change waiting for another user to approve it.
  pendingIban String     @default("")
  pendingBy   String?    @db.Uuid
  pendingAt   DateTime?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  suppliers Supplier[]

  @@unique([tenantId, name])
}

/// Completion certificates issued before the system (from the approved workbook), kept for reference only.
model LegacyCertificate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  seq          Int
  date         DateTime @db.Date
  schoolName   String   @default("")
  supplier     String
  subject      String   @default("")
  orderNo      String   @default("")
  invoice      String   @default("")
  orderValue   Decimal  @default(0) @db.Decimal(18, 2)
  orderDate    DateTime? @db.Date
  deliveryDate DateTime? @db.Date
  delivered    Decimal  @default(0) @db.Decimal(18, 2)
  lateDays     Int      @default(0)
  finePct      Decimal  @default(0) @db.Decimal(8, 2)
  fine         Decimal  @default(0) @db.Decimal(18, 2)
  net          Decimal  @default(0) @db.Decimal(18, 2)
  note         String   @default("")

  @@unique([tenantId, seq])
  @@index([tenantId, supplier])
  @@index([tenantId, schoolName])
}

model Budget {
  id           String          @id @default(uuid()) @db.Uuid
  schoolId     String          @db.Uuid
  yearId       String          @db.Uuid
  year         FiscalYear      @relation(fields: [yearId, schoolId], references: [id, schoolId])
  code         String
  name         String
  approved     Decimal         @db.Decimal(18, 2)
  committed    Decimal         @default(0) @db.Decimal(18, 2)
  spent        Decimal         @default(0) @db.Decimal(18, 2)
  entries      Ledger[]
  items        Item[]
  expenses     Expense[]
  direct       DirectExpense[]
  nameEn       String          @default("")
  assetCode    String          @default("")
  groupKey     String          @default("")
  schoolAmount Decimal         @default(0) @db.Decimal(18, 2)
  kgAmount     Decimal         @default(0) @db.Decimal(18, 2)
  sort         Int             @default(0)

  @@unique([id, schoolId, yearId])
  @@unique([schoolId, yearId, code])
}

model Case {
  id                String        @id @default(uuid()) @db.Uuid
  schoolId          String        @db.Uuid
  yearId            String        @db.Uuid
  school            School        @relation(fields: [schoolId], references: [id])
  year              FiscalYear    @relation(fields: [yearId, schoolId], references: [id, schoolId])
  number            String
  subject           String
  origin            String        @default("SCHOOL")
  state             String        @default("DRAFT")
  createdBy         String        @db.Uuid
  accountantName    String
  principalName     String
  supplierId        String?       @db.Uuid
  supplier          Supplier?     @relation(fields: [supplierId, schoolId], references: [id, schoolId])
  evaluationHtml    String?
  orderHtml         String?
  supplierSnapshot  Json?
  selectedQuoteId   String?       @db.Uuid
  total             Decimal       @default(0) @db.Decimal(18, 2)
  ministryReference String?
  dueDate           DateTime?     @db.Date
  issueDate         DateTime?     @db.Date
  orderNumber       String?
  evaluationNumber  String?
  awardReason       String?
  evaluationBy      String?       @db.Uuid
  issuedBy          String?       @db.Uuid
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  items             Item[]
  quotes            Quote[]
  deliveries        Delivery[]
  certificates      Certificate[]
  evidence          Evidence[]
  erp               Erp?
  returns           CaseReturn[]
  approvals         Approval[]
  comments          CaseComment[]
  method            String?
  exclusiveReason   String?
  deliveryDays      Int?
  policy            Json?
  reportDate        DateTime?     @db.Date

  @@unique([id, schoolId, yearId])
  @@unique([schoolId, yearId, number])
  @@index([schoolId, yearId, state])
}

model Item {
  id            String    @id @default(uuid()) @db.Uuid
  caseId        String    @db.Uuid
  schoolId      String    @db.Uuid
  yearId        String    @db.Uuid
  case          Case      @relation(fields: [caseId, schoolId, yearId], references: [id, schoolId, yearId])
  budgetId      String    @db.Uuid
  budget        Budget    @relation(fields: [budgetId, schoolId, yearId], references: [id, schoolId, yearId])
  name          String
  unit          String    @default("عدد")
  qty           Decimal   @db.Decimal(12, 3)
  unitPrice     Decimal   @default(0) @db.Decimal(18, 4)
  value         Decimal   @default(0) @db.Decimal(18, 2)
  acceptedQty   Decimal   @default(0) @db.Decimal(12, 3)
  acceptedValue Decimal   @default(0) @db.Decimal(18, 2)
  certifiedQty  Decimal   @default(0) @db.Decimal(12, 3)
  portions      Portion[]
  position      Int       @default(0)

  @@unique([id, caseId])
}

model Quote {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  yearId     String    @db.Uuid
  caseId     String    @db.Uuid
  case       Case      @relation(fields: [caseId, schoolId, yearId], references: [id, schoolId, yearId])
  supplierId String    @db.Uuid
  supplier   Supplier  @relation(fields: [supplierId, schoolId], references: [id, schoolId])
  reference  String
  prices     Json
  total      Decimal   @db.Decimal(18, 2)
  compliant  Boolean   @default(true)
  note       String    @default("")
  quoteDate  DateTime? @db.Date

  @@unique([caseId, supplierId])
}

model Delivery {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @db.Uuid
  yearId    String    @db.Uuid
  caseId    String    @db.Uuid
  case      Case      @relation(fields: [caseId, schoolId, yearId], references: [id, schoolId, yearId])
  date      DateTime  @db.Date
  note      String
  invoice   String
  /// Total on the supplier invoice as entered; must equal the value of the accepted quantities.
  invoiceAmount Decimal? @db.Decimal(18, 2)
  createdBy String    @db.Uuid
  portions  Portion[]

  @@unique([id, caseId])
  @@unique([caseId, note])
}

model Portion {
  id            String       @id @default(uuid()) @db.Uuid
  deliveryId    String       @db.Uuid
  itemId        String       @db.Uuid
  caseId        String       @db.Uuid
  delivery      Delivery     @relation(fields: [deliveryId, caseId], references: [id, caseId])
  item          Item         @relation(fields: [itemId, caseId], references: [id, caseId])
  received      Decimal      @db.Decimal(12, 3)
  accepted      Decimal      @db.Decimal(12, 3)
  value         Decimal      @db.Decimal(18, 2)
  lateDays      Int
  rawFine       Decimal      @db.Decimal(24, 6)
  certificateId String?      @db.Uuid
  certificate   Certificate? @relation(fields: [certificateId, caseId], references: [id, caseId])

  @@unique([deliveryId, itemId])
}

model Certificate {
  id             String     @id @default(uuid()) @db.Uuid
  caseId         String     @db.Uuid
  case           Case       @relation(fields: [caseId], references: [id])
  number         String
  kind           String
  gross          Decimal    @db.Decimal(18, 2)
  fine           Decimal    @db.Decimal(18, 2)
  net            Decimal    @db.Decimal(18, 2)
  snapshot       Json
  html           String
  coverHtml      String?
  finalized      Boolean    @default(false)
  signedEvidence Evidence[]
  createdBy      String     @db.Uuid
  issuedBy       String     @db.Uuid
  createdAt      DateTime   @default(now())
  portions       Portion[]
  details        Json?

  @@unique([id, caseId])
  @@unique([caseId, number])
}

model Evidence {
  id            String       @id @default(uuid()) @db.Uuid
  caseId        String       @db.Uuid
  case          Case         @relation(fields: [caseId], references: [id])
  code          Int
  certificateId String?      @db.Uuid
  certificate   Certificate? @relation(fields: [certificateId, caseId], references: [id, caseId])
  name          String
  mime          String
  hash          String
  data          Bytes?
  status        String       @default("PENDING")
  uploadedBy    String       @db.Uuid
  verifiedBy    String?      @db.Uuid
  reason        String       @default("")
  scanStatus    String       @default("UNSCANNED")
  createdAt     DateTime     @default(now())

  @@index([caseId, code])
}

model Erp {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @unique @db.Uuid
  case      Case     @relation(fields: [caseId], references: [id])
  reference String
  schoolId  String   @db.Uuid
  date      DateTime @db.Date
  actor     String   @db.Uuid
  evidence  String

  @@unique([schoolId, reference])
}

model Ledger {
  id         String   @id @default(uuid()) @db.Uuid
  budgetId   String   @db.Uuid
  budget     Budget   @relation(fields: [budgetId], references: [id])
  eventKey   String   @unique
  kind       String
  commitment Decimal  @db.Decimal(18, 2)
  expense    Decimal  @db.Decimal(18, 2)
  source     String
  actor      String   @db.Uuid
  createdAt  DateTime @default(now())
}

model Imprest {
  id          String         @id @default(uuid()) @db.Uuid
  schoolId    String         @db.Uuid
  yearId      String         @db.Uuid
  year        FiscalYear     @relation(fields: [yearId, schoolId], references: [id, schoolId])
  name        String
  custodian   String
  type        String
  balance     Decimal        @db.Decimal(18, 2)
  closed      Boolean        @default(false)
  expenses    Expense[]
  settlements Settlement[]
  movements   CashMovement[]
  amount      Decimal        @default(0) @db.Decimal(18, 2)
  reference   String         @default("")
  createdAt   DateTime       @default(now())

  @@unique([id, schoolId, yearId])
}

model Expense {
  id           String      @id @default(uuid()) @db.Uuid
  schoolId     String      @db.Uuid
  yearId       String      @db.Uuid
  imprestId    String      @db.Uuid
  imprest      Imprest     @relation(fields: [imprestId, schoolId, yearId], references: [id, schoolId, yearId])
  budgetId     String      @db.Uuid
  budget       Budget      @relation(fields: [budgetId, schoolId, yearId], references: [id, schoolId, yearId])
  description  String
  invoice      String
  date         DateTime    @db.Date
  amount       Decimal     @db.Decimal(18, 2)
  proof        String      @default("")
  createdBy    String      @db.Uuid
  settlementId String?     @db.Uuid
  settlement   Settlement? @relation(fields: [settlementId, imprestId], references: [id, imprestId])
  vendor       String      @default("")
  accountCode  String      @default("")
  note         String      @default("")

  @@index([imprestId])
}

model Settlement {
  id          String    @id @default(uuid()) @db.Uuid
  imprestId   String    @db.Uuid
  imprest     Imprest   @relation(fields: [imprestId], references: [id])
  type        String
  amount      Decimal   @db.Decimal(18, 2)
  replenished Boolean   @default(false)
  erpRef      String?
  actor       String    @db.Uuid
  html        String
  createdAt   DateTime  @default(now())
  expenses    Expense[]
  number      Int       @default(1)
  coverHtml   String?
  details     Json?

  @@unique([id, imprestId])
}

model CashMovement {
  id        String   @id @default(uuid()) @db.Uuid
  imprestId String   @db.Uuid
  imprest   Imprest  @relation(fields: [imprestId], references: [id])
  amount    Decimal  @db.Decimal(18, 2)
  kind      String
  reference String
  actor     String   @db.Uuid
  createdAt DateTime @default(now())
}

model Audit {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String?  @db.Uuid
  tenantId  String?  @db.Uuid
  actor     String   @db.Uuid
  action    String
  entity    String
  detail    Json
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

model Sequence {
  key   String @id
  value Int
}

model Idempotency {
  key       String   @id
  hash      String
  result    Json
  createdAt DateTime @default(now())
}

model ReportRun {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  yearId    String   @db.Uuid
  actor     String   @db.Uuid
  title     String
  snapshot  Json
  html      String
  hash      String
  createdAt DateTime @default(now())

  @@index([schoolId, yearId, createdAt])
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  date      DateTime @db.Date
  name      String
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([tenantId, date])
}

model PolicySetting {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  key           String
  value         Json
  effectiveFrom DateTime @db.Date
  reason        String
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now())

  @@index([tenantId, key, effectiveFrom])
}

model BudgetCatalog {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  code      String
  nameAr    String
  nameEn    String  @default("")
  assetCode String  @default("")
  groupKey  String
  note      String  @default("")
  sort      Int     @default(0)
  active    Boolean @default(true)

  @@unique([tenantId, code])
}

model BudgetPlan {
  id              String     @id @default(uuid()) @db.Uuid
  schoolId        String     @db.Uuid
  yearId          String     @db.Uuid
  school          School     @relation(fields: [schoolId], references: [id])
  year            FiscalYear @relation(fields: [yearId, schoolId], references: [id, schoolId])
  schoolBuildings Int        @default(1)
  kgBuildings     Int        @default(0)
  studentsSchool  Int        @default(0)
  studentsKg      Int        @default(0)
  teachersSchool  Int        @default(0)
  teachersKg      Int        @default(0)
  adminSchool     Int        @default(0)
  adminKg         Int        @default(0)
  updatedAt       DateTime   @updatedAt

  @@unique([schoolId, yearId])
}

/// Expenses paid directly (not through an imprest) or entered from prior records; they post to the budget line.
model DirectExpense {
  id          String     @id @default(uuid()) @db.Uuid
  schoolId    String     @db.Uuid
  yearId      String     @db.Uuid
  year        FiscalYear @relation(fields: [yearId, schoolId], references: [id, schoolId])
  budgetId    String     @db.Uuid
  budget      Budget     @relation(fields: [budgetId, schoolId, yearId], references: [id, schoolId, yearId])
  date        DateTime   @db.Date
  vendor      String     @default("")
  reference   String     @default("")
  description String
  amount      Decimal    @db.Decimal(18, 2)
  source      String     @default("MANUAL")
  note        String     @default("")
  createdBy   String     @db.Uuid
  createdAt   DateTime   @default(now())

  @@index([schoolId, yearId])
}

/// Shared document library: commercial registrations, undertakings and similar papers of companies.
model Archive {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  kind         String
  company      String
  title        String
  note         String   @default("")
  fileName     String
  mime         String
  size         Int
  hash         String
  data         Bytes?
  storage      String   @default("DATABASE")
  remoteId     String   @default("")
  remoteUrl    String   @default("")
  uploadedBy   String   @db.Uuid
  uploaderName String
  createdAt    DateTime @default(now())

  @@index([tenantId, company])
}

/// Shared notes board (general entries, settlements, depreciation…); read by all, edited by the administrator.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  title     String
  body      String
  category  String   @default("")
  sort      Int      @default(0)
  updatedBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sign-in record: address, browser and (with the user's consent) the device location; visible to the administrator.
model LoginLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  ip        String
  userAgent String   @default("")
  lat       Float?
  lng       Float?
  accuracy  Float?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A comparison of the monthly ERP expense report (PDF) with the figures recorded in the system.
model ErpRecon {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  yearId    String   @db.Uuid
  period    String
  mode      String
  fileName  String
  rows      Json
  settled   Int      @default(0)
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())

  @@index([schoolId, yearId])
}

/// One check of the signed paper file of a case (uploaded on the screen or sent to the Telegram bot).
model FileCheck {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  /// CASE: a purchase file (caseId = the case); IMPREST: a settlement statement (caseId = the settlement).
  kind      String   @default("CASE")
  caseId    String   @db.Uuid
  source    String
  mode      String
  files     Json
  pages     Int
  facts     Json
  findings  Json
  result    String
  errors    Int
  warnings  Int
  notes     Int
  html      String
  createdBy String   @db.Uuid
  byName    String
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([schoolId, createdAt])
}

/// A case sent back by the auditors, with the reasons (fixed list) and its resolution.
model CaseReturn {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @db.Uuid
  caseId      String    @db.Uuid
  case        Case      @relation(fields: [caseId], references: [id])
  date        DateTime  @db.Date
  reasons     Json
  note        String    @default("")
  createdBy   String    @db.Uuid
  byName      String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?   @db.Uuid
  resolveNote String    @default("")

  @@index([schoolId, date])
  @@index([caseId])
}

/// Remarks on a case (accountants, the administrator, the read-only auditor), optionally about one document.
model CaseComment {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  caseId    String   @db.Uuid
  case      Case     @relation(fields: [caseId], references: [id])
  userId    String   @db.Uuid
  byName    String
  text      String
  docCode   Int?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

/// A request for another user's approval (a certificate above the administrator's limit).
model Approval {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @db.Uuid
  caseId        String    @db.Uuid
  case          Case      @relation(fields: [caseId], references: [id])
  kind          String
  status        String    @default("PENDING")
  requestedBy   String    @db.Uuid
  requestedName String
  decidedBy     String?   @db.Uuid
  decidedName   String    @default("")
  note          String    @default("")
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([caseId])
  @@index([schoolId, status])
}

/// Who was the school principal from a date on: documents print the principal on their own date.
model PrincipalTerm {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  fromDate  DateTime @db.Date
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([schoolId, fromDate])
}
